# รับค่าน้ำหนักและส่วนสูง
weight = float(input("ป้อนน้ำหนัก (kg): "))
height_m = float(input("ป้อนส่วนสูง (cm): ")) / 100  # แปลงเซนติเมตรเป็นเมตร

# คำนวณค่า BMI
bmi = weight / (height_m ** 2)

print(f"ค่า BMI ของคุณคือ: {bmi:.2f}")

# เช็กเกณฑ์
if bmi < 18.5:
    print("ผลลัพธ์: น้ำหนักน้อยกว่าเกณฑ์")
elif bmi < 23:
    print("ผลลัพธ์: น้ำหนักปกติ (สุขภาพดี)")
else:
    print("ผลลัพธ์: น้ำหนักเกินเกณฑ์")
